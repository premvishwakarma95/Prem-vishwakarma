# Chatbot LLM settings (copy to .env.local and fill in; never commit real keys).
# Free option used by default: Groq — create a key at https://console.groq.com/keys
LLM_API_KEY=
# Optional overrides (any OpenAI-compatible API):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b   (see https://console.groq.com/docs/models)
#
# Alternative free providers:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<any model ending in :free>
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
